# OrbitOS — Environment Configuration
# Copy this file to .env and fill in your API keys

# ── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=OrbitOS
APP_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# ── Lemma SDK (Core Orchestration) ────────────────────────────────────────────
# Get from: https://lemma.work/dashboard → API Keys
LEMMA_API_KEY=your_lemma_api_key_here
LEMMA_POD_ID=orbitos-startup-pod

# ── AI Models ────────────────────────────────────────────────────────────────
# Primary: Google Gemini (recommended for best performance)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback: OpenAI GPT-4
OPENAI_API_KEY=your_openai_key_here

# Alternative: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://orbitos:orbitos@localhost:5432/orbitos
REDIS_URL=redis://localhost:6379/0

# ── GitHub Integration ────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_ORG=your-github-org-name

# ── Slack Integration ─────────────────────────────────────────────────────────
# Create at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_DEFAULT_CHANNEL=#general

# ── Gmail Integration ─────────────────────────────────────────────────────────
# Enable Gmail API at: https://console.cloud.google.com
GMAIL_CREDENTIALS={"type":"service_account",...}
GMAIL_TOKEN=

# ── Jira Integration ──────────────────────────────────────────────────────────
# Get at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token
JIRA_EMAIL=your@email.com
JIRA_DOMAIN=your-company.atlassian.net

# ── Notion Integration ────────────────────────────────────────────────────────
# Get at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_token
NOTION_WORKSPACE_ID=your_workspace_id

# ── Authentication (Clerk) ────────────────────────────────────────────────────
# Get at: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://orbitos.ai"]
